{
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(npx wrangler*)",
      "PowerShell(npx wrangler*)",
      "Bash(wrangler*)",
      "PowerShell(wrangler*)",
      "Bash(node .claude/hooks/deploy.js*)",
      "PowerShell(node .claude/hooks/deploy.js*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-lang.js\"",
            "timeout": 15,
            "statusMessage": "Έλεγχος EL/EN..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-contrast.js\"",
            "timeout": 15,
            "statusMessage": "Έλεγχος αντίθεσης χρωμάτων..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-reminder.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
