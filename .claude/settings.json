{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-lang.js\"",
            "timeout": 15,
            "statusMessage": "Έλεγχος EL/EN..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy.js\"",
            "timeout": 180,
            "statusMessage": "Deploy στο Cloudflare Pages..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy.js\"",
            "timeout": 180,
            "statusMessage": "Deploy στο Cloudflare Pages..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-reminder.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
